{
  "name": "pcs-front",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/set-env.mjs dev && vite",
    "dev:test": "node scripts/set-env.mjs test && vite",
    "dev:prod": "node scripts/set-env.mjs prod && vite",
    "build": "node scripts/set-env.mjs prod && run-s type-check build-only",
    "build:dev": "node scripts/set-env.mjs dev && run-s type-check build-only",
    "build:test": "node scripts/set-env.mjs test && run-s type-check build-only",
    "preview": "vite preview",
    "bff:dev": "tsx watch bff/src/index.ts",
    "bff:type-check": "tsc -p bff/tsconfig.json --noEmit",
    "bff:build": "tsc -p bff/tsconfig.json",
    "bff:start": "node bff/dist/bff/src/index.js",
    "test:unit": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "lint:style": "stylelint \"src/**/*.{css,less,vue}\"",
    "lint:fix": "oxlint . --fix && eslint . --fix --cache",
    "check:color": "node scripts/check-hardcode-color.mjs",
    "check:tokens": "node scripts/gen-tokens.mjs --check",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:entry": "node scripts/check-entrypoints.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:size": "node scripts/check-file-size.mjs",
    "gate": "run-s type-check lint:oxlint lint:eslint lint:style test:coverage check:color check:tokens check:imports check:size",
    "verify": "run-s build check:entry check:imports",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.58.0",
    "@baiyun/auth-center-browser": "file:../BYAuthCenter/packages/auth-center-browser",
    "@baiyun/auth-center-node": "file:../BYAuthCenter/packages/auth-center-node",
    "axios": "^1.18.1",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.15",
    "echarts": "^6.1.0",
    "fastify": "^5.6.2",
    "ioredis": "^5.11.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.20",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.69.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "less": "^4.6.7",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.69.0",
    "postcss-html": "^1.8.1",
    "postcss-less": "^6.0.0",
    "prettier": "3.8.4",
    "stylelint": "^17.14.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.16",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
