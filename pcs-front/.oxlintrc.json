{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vue", "vitest"],
  "env": {
    "browser": true
  },
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "config.example.js",
    "public/config.js",
    "public/env.js",
    "deploy/config.*.js",
    "deploy/env.js.template"
  ]
}
